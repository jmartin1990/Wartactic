<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!--
    CONCEPTO CLAVE VECTORIAL:
    El viewport (24x24) define la rejilla matemática sobre la que se dibujan los caminos (paths).
    Al ser vectorial, el icono se escala a cualquier tamaño sin perder nitidez.
    Los colores están en blanco (#FFFFFF) para permitir que Jetpack Compose lo tinte
    dinámicamente mediante la propiedad `tint` (Verde Lima o Naranja Alerta).
  -->

  <!-- 1. Marco cuadrado exterior de la mirilla -->
  <!-- M 2,2 (Mover a 2,2) -> L (Línea a) -> Z (Cerrar camino) -->
  <path
      android:pathData="M 2,2 L 22,2 L 22,22 L 2,22 Z"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="1.5"
      android:fillColor="#00000000" /> <!-- fillColor transparente -->

  <!-- 2. Círculo intermedio -->
  <!-- 'm' relativo y 'a' (arco/elipse) dibuja la circunferencia de radio 5 centrada en (12,12) -->
  <path
      android:pathData="M 12,12 m -5,0 a 5,5 0 1,0 10,0 a 5,5 0 1,0 -10,0"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="1.5"
      android:fillColor="#00000000" />

  <!-- 3. Punto / Diana central -->
  <!-- Dibuja un círculo relleno sólido de radio 2 en el centro exacto (12,12) -->
  <path
      android:pathData="M 12,12 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0"
      android:fillColor="#FFFFFF" />

  <!-- 4. Líneas en cruz tácticas (Retícula) -->
  <!-- M (Mover) L (Línea) para dibujar las 4 pequeñas muescas en los 4 puntos cardinales -->
  <path
      android:pathData="M 12,2 L 12,7 M 12,17 L 12,22 M 2,12 L 7,12 M 17,12 L 22,12"
      android:strokeColor="#FFFFFF"
      android:strokeWidth="1.5" />
</vector>